# Use the nightly slim Rust image
FROM rustlang/rust:nightly-slim

# Create app directory
WORKDIR /usr/src/app

# Copy only Cargo.toml first to cache dependencies
COPY Cargo.toml .

# Create a dummy src/main.rs to pre-cache dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs

# Build dependencies first (this caches layers)
RUN cargo build --release

# Remove dummy main file
RUN rm -rf src

# Copy the full project source
COPY . .

# Final build
RUN cargo build --release

# Set the compiled binary as the default command
ENTRYPOINT ["./target/release/rustcompress_rle"]