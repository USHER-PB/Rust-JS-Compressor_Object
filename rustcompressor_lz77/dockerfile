# Use the nightly slim Rust image
FROM rustlang/rust:nightly-slim

# Create app directory
WORKDIR /usr/src/app

# Copy only Cargo.toml first to cache dependencies
COPY Cargo.toml .

# Create necessary directories and dummy files
RUN mkdir -p src benches && \
    echo "fn main() {}" > src/main.rs && \
    echo "pub fn dummy() {}" > src/lib.rs && \
    echo "use criterion::{black_box, criterion_group, criterion_main, Criterion};" > benches/benchmark.rs

# Build dependencies first (this caches layers)
RUN cargo build --release

# Remove dummy files
RUN rm -rf src benches

# Copy the full project source
COPY . .

# Final build
RUN cargo build --release

# Copy the binary to a known location
RUN cp target/release/rustcompressor_lz77 /usr/local/bin/

# Set the entrypoint to the binary
ENTRYPOINT ["/usr/local/bin/rustcompressor_lz77"]